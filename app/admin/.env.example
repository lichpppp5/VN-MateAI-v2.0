# VN-MateAI Admin Control Center
# Copy this to .env.local and fill in your values

# API Configuration
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Authentication
NEXTAUTH_SECRET=your-super-secret-key-here
NEXTAUTH_URL=http://localhost:3001

# Optional: External Services
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# MS_GRAPH_CLIENT_ID=...
# MS_GRAPH_CLIENT_SECRET=...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# TELEGRAM_BOT_TOKEN=...
# Phase 78: bắt buộc khi chạy Admin ở cổng khác backend (CORS Zero-Trust).
# Backend KHÔNG cho phép origin tùy ý — phải khai báo tường minh.
VNMATEAI_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
