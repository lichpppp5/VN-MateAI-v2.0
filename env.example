# VN-MateAI — cấu hình cài đặt (chép thành .env; install.sh / install.ps1 tự tạo và sinh mật khẩu ngẫu nhiên).
# KHÔNG gửi tệp .env cho người khác: có mật khẩu CSDL và mật khẩu quản trị.

VNMATE_VERSION=2.0.1
# commercial (mặc định, bản giao khách hàng) | internal (bản nội bộ: AI tự tạo kỹ năng, kỹ năng demo, /docs bật được)
VNMATE_EDITION=commercial
TZ=Asia/Ho_Chi_Minh

# Cổng trên máy chủ: Portal https://<máy chủ>/ , HUD https://<máy chủ>/hud
VNMATE_HTTPS_PORT=443
# Cổng cho robot ESP32 / Xiaozhi
VNMATE_IOT_PORT=8000
# Địa chỉ LAN (IP hoặc tên miền) mà máy trạm / robot dùng để nối tới máy chủ — trình cài tự dò; sửa nếu máy có nhiều mạng.
VNMATE_PUBLIC_HOST=

# Mật khẩu (để trống thì trình cài sinh ngẫu nhiên). Tài khoản: admin / manager / viewer
VNMATE_ADMIN_PASSWORD=
VNMATE_MANAGER_PASSWORD=
VNMATE_VIEWER_PASSWORD=
VNMATE_PG_PASSWORD=
VNMATE_REDIS_PASSWORD=

# Gateway mô hình AI (OpenAI-compatible: 9Router, VNmateai-proxy, OpenAI, OpenRouter, DeepSeek...).
# Chỉ dùng để tạo cấu hình LẦN ĐẦU; sau đó sửa ở Portal -> Quản Lý Trợ Lý AI.
# Ví dụ URL: http://10.0.0.5:20128/v1  hoặc  https://api.openai.com/v1
VNMATE_LLM_BASE_URL=
VNMATE_LLM_API_KEY=
# Ví dụ model: gpt-4o-mini, deepseek-chat, ag/gemini-3.8-flash-low
VNMATE_LLM_MODEL=
# Model dự phòng (tuỳ chọn), cách nhau dấu phẩy
VNMATE_LLM_FALLBACK_MODELS=

VNMATE_ASSISTANT_NAME=Ly Ly
# MCP server tham chiếu chính thức đã rà soát (giờ, đọc trang web công khai — chặn địa chỉ nội bộ). 0 = tắt.
VNMATE_MCP_REFERENCE=1
